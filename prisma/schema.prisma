generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Area {
  idArea     Int       @id @default(autoincrement()) @map("id_area")
  nombreArea String    @map("nombre_area") @db.VarChar(100)
  contacto   String    @db.VarChar(100)
  telefono   String    @db.VarChar(20)
  correo     String    @db.VarChar(100)
  idSucursal Int?      @map("id_sucursal")
  isActive   Boolean?  @default(true) @map("is_active")
  createdAt  DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  sucursal   Sucursal?  @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade, onUpdate: Restrict, map: "fk_area_sucursal")
  equipos    Equipo[]
  usuarios   Usuario[]

  @@index([idSucursal], map: "fk_area_sucursal")
  @@map("area")
}

model CitaSoporte {
  idCita           Int                 @id @default(autoincrement()) @map("id_cita")
  idSoporte        Int                 @map("id_soporte")
  idSucursal       Int                 @map("id_sucursal")
  fechaProgramada  DateTime            @map("fecha_programada") @db.DateTime(0)
  estado           CitaSoporteEstado?  @default(Pendiente)
  observaciones    String?             @db.Text
  createdAt        DateTime?           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?           @default(now()) @map("updated_at") @db.DateTime(0)

  usuario          Usuario             @relation(fields: [idSoporte], references: [idUsuario], onDelete: Cascade, onUpdate: Restrict, map: "fk_cita_soporte")
  sucursal         Sucursal            @relation(fields: [idSucursal], references: [idSucursal], onDelete: Cascade, onUpdate: Restrict, map: "fk_cita_sucursal")
  citasTickets     CitaTicket[]

  @@index([idSoporte], map: "fk_cita_soporte")
  @@index([idSucursal], map: "fk_cita_sucursal")
  @@map("citas_soporte")
}

model CitaTicket {
  idCita      Int         @map("id_cita")
  idTicket    Int         @map("id_ticket")

  citaSoporte CitaSoporte @relation(fields: [idCita], references: [idCita], onDelete: Cascade, onUpdate: Restrict, map: "fk_citastickets_cita")
  ticket      Ticket      @relation(fields: [idTicket], references: [idTickets], onDelete: Cascade, onUpdate: Restrict, map: "fk_citastickets_ticket")

  @@id([idCita, idTicket])
  @@index([idTicket], map: "fk_citastickets_ticket")
  @@map("citas_tickets")
}

model Cliente {
  idCliente                Int                 @id @default(autoincrement()) @map("id_cliente")
  tipoCliente              ClienteTipoCliente? @default(JURIDICA) @map("tipo_cliente")
  numeroDocumento          String?             @unique(map: "numero_documento") @map("numero_documento") @db.VarChar(20)
  nombrePrincipal          String              @map("nombre_principal") @db.VarChar(150)
  direccion                String?             @db.VarChar(200)
  telefono                 String?             @db.VarChar(20)
  correo                   String?             @db.VarChar(100)
  rubro                    String?             @db.VarChar(100)
  idPlan                   Int?                @map("id_plan")
  fechaInicioPlan          DateTime?           @map("fecha_inicio_plan") @db.Date
  fechaFinalizacionPlan    DateTime?           @map("fecha_finalizacion_plan") @db.Date
  costoNegociado           Decimal?            @map("costo_negociado") @db.Decimal(10, 2)
  limiteEquiposContratado  Int?                @map("limite_equipos_contratado")
  fechaRegistro            DateTime?           @default(now()) @map("fecha_registro") @db.DateTime(0)
  isActive                 Boolean?            @default(true) @map("is_active")
  createdAt                DateTime?           @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                DateTime?           @default(now()) @map("updated_at") @db.DateTime(0)

  plan                     Plan?               @relation(fields: [idPlan], references: [idPlan], onUpdate: Restrict, map: "fk_clientes_plan")
  equipos                  Equipo[]
  sucursales               Sucursal[]
  usuarios                 Usuario[]

  @@index([idPlan], map: "fk_clientes_plan")
  @@map("clientes")
}

model Equipo {
  idEquipo         Int                @id @default(autoincrement()) @map("id_equipo")
  nombreEquipo     String?            @map("nombre_equipo") @db.VarChar(100)
  tipo             String             @db.VarChar(50)
  marca            String             @db.VarChar(50)
  numSerie         String?            @unique(map: "num_serie") @map("num_serie") @db.VarChar(100)
  nombreUsuario    String?            @map("nombre_usuario") @db.VarChar(100)
  ultRevision      DateTime?          @map("ult_revision") @db.Date
  revProgramada    DateTime?          @map("rev_programada") @db.Date
  idTrabajador     Int?               @map("id_trabajador")
  idCliente        Int?               @map("id_cliente")
  idSucursal       Int?               @map("id_sucursal")
  idArea           Int?               @map("id_area")
  isActive         Boolean?           @default(true) @map("is_active")
  createdAt        DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?          @default(now()) @map("updated_at") @db.DateTime(0)

  usuario          Usuario?           @relation(fields: [idTrabajador], references: [idUsuario], onDelete: Cascade, onUpdate: Restrict, map: "fk_eqipos_trabajador")
  area             Area?              @relation(fields: [idArea], references: [idArea], onUpdate: Restrict, map: "fk_equipos_area")
  cliente          Cliente?           @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Restrict, map: "fk_equipos_cliente")
  sucursal         Sucursal?          @relation(fields: [idSucursal], references: [idSucursal], onUpdate: Restrict, map: "fk_equipos_sucursal")
  registroHardware RegistroHardware[]
  softwareEquipos  SoftwareEquipo[]
  tickets          Ticket[]

  @@index([idTrabajador], map: "fk_eqipos_trabajador")
  @@index([idArea], map: "fk_equipos_area")
  @@index([idCliente], map: "fk_equipos_cliente")
  @@index([idSucursal], map: "fk_equipos_sucursal")
  @@map("equipos")
}

model Hardware {
  idHardware       Int                @id @default(autoincrement()) @map("id_hardware")
  tipoEquipo       String             @map("tipo_equipo") @db.VarChar(100)
  numeroSerie      String             @map("numero_serie") @db.VarChar(100)
  fechaCompra      DateTime           @map("fecha_compra") @db.Date
  marca            String             @db.VarChar(100)
  proveedor        String             @db.VarChar(100)
  urlFactura       String?            @map("url_factura") @db.VarChar(255)
  descripcion      String?            @db.Text
  ultRevision      DateTime?          @map("ult_revision") @db.Date
  revProgramada    DateTime?          @map("rev_programada") @db.Date
  isActive         Boolean?           @default(true) @map("is_active")
  createdAt        DateTime?          @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?          @default(now()) @map("updated_at") @db.DateTime(0)

  registroHardware RegistroHardware[]

  @@map("hardware")
}

model Plan {
  idPlan        Int       @id @default(autoincrement()) @map("id_plan")
  numeroPlan    Int       @map("numero_plan")
  tipo          String    @db.VarChar(100)
  servicios     String    @db.LongText
  precio        Decimal?  @default(0.00) @db.Decimal(10, 2)
  limiteEquipos Int?      @map("limite_equipos")
  isActive      Boolean?  @default(true) @map("is_active")
  createdAt     DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  clientes      Cliente[]

  @@map("planes")
}

model RegistroHardware {
  idRH             Int       @id @default(autoincrement()) @map("id_RH")
  fechaInstalacion DateTime  @default(now()) @map("fecha_instalacion") @db.DateTime(0)
  descripcion      String    @db.Text
  serie            String    @db.VarChar(100)
  proveedor        String    @db.VarChar(255)
  isActual         Boolean?  @default(true) @map("is_actual")
  idHardware       Int?      @map("id_hardware")
  idEquipo         Int?      @map("id_equipo")
  createdAt        DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  equipo           Equipo?   @relation(fields: [idEquipo], references: [idEquipo], onDelete: Cascade, onUpdate: Restrict, map: "fk_rh_equipo")
  hardware         Hardware? @relation(fields: [idHardware], references: [idHardware], onDelete: Cascade, onUpdate: Restrict, map: "fk_rh_hardware")

  @@index([idEquipo], map: "fk_rh_equipo")
  @@index([idHardware], map: "fk_rh_hardware")
  @@map("registro_hardware")
}

model Rol {
  idRol     Int       @id @default(autoincrement()) @map("id_rol")
  nombre    String    @db.VarChar(50)
  createdAt DateTime? @default(now()) @map("created_at") @db.DateTime(0)

  usuarios  Usuario[]

  @@map("rol")
}

model Software {
  idSoftware       Int              @id @default(autoincrement()) @map("id_software")
  nombreSoftware   String           @map("nombre_software") @db.VarChar(100)
  licencia         String           @db.VarChar(100)
  correo           String           @db.VarChar(100)
  password         String           @db.VarChar(255)
  fechaInstalacion DateTime         @map("fecha_instalacion") @db.Date
  fechaCaducidad   DateTime         @map("fecha_caducidad") @db.Date
  proveedor        String           @db.VarChar(100)
  isActive         Boolean?         @default(true) @map("is_active")
  createdAt        DateTime?        @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt        DateTime?        @default(now()) @map("updated_at") @db.DateTime(0)

  softwareEquipos  SoftwareEquipo[]

  @@map("software")
}

model SoftwareEquipo {
  idSoftwareEquipos Int       @id @default(autoincrement()) @map("id_software_equipos")
  idSoftware        Int       @map("id_software")
  idEquipo          Int       @map("id_equipo")
  fechaInstalacion  DateTime? @default(now()) @map("fecha_instalacion") @db.DateTime(0)
  licenciaAsignada  String?   @map("licencia_asignada") @db.VarChar(100)
  isActive          Boolean?  @default(true) @map("is_active")
  observaciones     String?   @db.Text
  createdAt         DateTime? @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime? @default(now()) @map("updated_at") @db.DateTime(0)

  equipo            Equipo    @relation(fields: [idEquipo], references: [idEquipo], onDelete: Cascade, onUpdate: Restrict, map: "fk_se_equipos")
  software          Software  @relation(fields: [idSoftware], references: [idSoftware], onDelete: Cascade, onUpdate: Restrict, map: "fk_se_software")

  @@index([idEquipo], map: "fk_se_equipos")
  @@index([idSoftware], map: "fk_se_software")
  @@map("software_equipos")
}

model Sucursal {
  idSucursal     Int           @id @default(autoincrement()) @map("id_sucursal")
  nombreSucursal String        @map("nombre_sucursal") @db.VarChar(255)
  encargado      String        @db.VarChar(255)
  telefono       String        @db.VarChar(20)
  direccion      String        @db.VarChar(255)
  correo         String        @db.VarChar(255)
  isPrincipal    Boolean?      @default(false) @map("is_principal")
  idCliente      Int?          @map("id_cliente")
  isActive       Boolean?      @default(true) @map("is_active")
  createdAt      DateTime?     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt      DateTime?     @default(now()) @map("updated_at") @db.DateTime(0)

  areas          Area[]
  citasSoporte   CitaSoporte[]
  equipos        Equipo[]
  cliente        Cliente?      @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Restrict, map: "fk_sucursal_cliente")
  usuarios       Usuario[]

  @@index([idCliente], map: "fk_sucursal_cliente")
  @@map("sucursales")
}

model Ticket {
  idTickets                          Int           @id @default(autoincrement()) @map("id_tickets")
  pin                                String        @unique(map: "pin") @db.VarChar(6)
  asunto                             String        @db.VarChar(255)
  detalle                            String        @db.Text
  estado                             TicketEstado? @default(Pendiente)
  idEquipo                           Int           @map("id_equipo")
  idTrabajador                       Int           @map("id_trabajador")
  idSoporte                          Int?          @map("id_soporte")
  esSoftware                         Boolean?      @default(false) @map("es_software")
  createdAt                          DateTime?     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                          DateTime?     @default(now()) @map("updated_at") @db.DateTime(0)

  citasTickets                       CitaTicket[]
  equipo                             Equipo        @relation(fields: [idEquipo], references: [idEquipo], onUpdate: Restrict, map: "fk_tickets_equipo")
  usuarioSoporte                     Usuario?      @relation("tickets_id_soporteTousuarios", fields: [idSoporte], references: [idUsuario], onDelete: Restrict, onUpdate: Restrict, map: "fk_tickets_soporte")
  usuarioTrabajador                  Usuario       @relation("tickets_id_trabajadorTousuarios", fields: [idTrabajador], references: [idUsuario], onUpdate: Restrict, map: "fk_tickets_trabajador")

  @@index([idEquipo], map: "fk_tickets_equipo")
  @@index([idSoporte], map: "fk_tickets_soporte")
  @@index([idTrabajador], map: "fk_tickets_trabajador")
  @@map("tickets")
}

model Usuario {
  idUsuario                              Int           @id @default(autoincrement()) @map("id_usuario")
  nombre                                 String        @db.VarChar(50)
  apellido                               String        @db.VarChar(50)
  correo                                 String?       @unique(map: "correo") @db.VarChar(255)
  password                               String        @db.VarChar(255)
  telefono                               String?       @db.VarChar(15)
  isActive                               Boolean?      @default(true) @map("is_active")
  idRol                                  Int?          @map("id_rol")
  idCliente                              Int?          @map("id_cliente")
  idSucursal                             Int?          @map("id_sucursal")
  idArea                                 Int?          @map("id_area")
  createdAt                              DateTime?     @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt                              DateTime?     @default(now()) @map("updated_at") @db.DateTime(0)

  citasSoporte                           CitaSoporte[]
  equipos                                Equipo[]
  ticketsSoporte                         Ticket[]      @relation("tickets_id_soporteTousuarios")
  ticketsTrabajador                      Ticket[]      @relation("tickets_id_trabajadorTousuarios")
  area                                   Area?         @relation(fields: [idArea], references: [idArea], onUpdate: Restrict, map: "fk_usuario_area")
  cliente                                Cliente?      @relation(fields: [idCliente], references: [idCliente], onDelete: Cascade, onUpdate: Restrict, map: "fk_usuario_cliente")
  rol                                    Rol?          @relation(fields: [idRol], references: [idRol], onDelete: Restrict, onUpdate: Restrict, map: "fk_usuario_rol")
  sucursal                               Sucursal?     @relation(fields: [idSucursal], references: [idSucursal], onUpdate: Restrict, map: "fk_usuario_sucursal")

  @@index([idArea], map: "fk_usuario_area")
  @@index([idCliente], map: "fk_usuario_cliente")
  @@index([idRol], map: "fk_usuario_rol")
  @@index([idSucursal], map: "fk_usuario_sucursal")
  @@map("usuarios")
}

enum ClienteTipoCliente {
  JURIDICA
  NATURAL
}

enum CitaSoporteEstado {
  Pendiente
  En_Camino    @map("En Camino")
  Completada
  Cancelada
  Reprogramada
}

enum TicketEstado {
  Pendiente
  Asignado
  En_Progreso  @map("En Progreso")
  Reabierto
  Cerrado
}